{
  "name": "agent-memory-workshop",
  "version": "1.0.0",
  "description": "A 3-hour workshop on context engineering through agent memory (Mastra + Neo4j).",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "chat": "tsx src/workshop/chat.ts",
    "step": "tsx src/workshop/harness/presets.ts",
    "scenario": "tsx src/workshop/scenarios/run.ts",
    "state": "tsx src/workshop/harness/state.ts",
    "reset": "tsx src/workshop/harness/reset.ts",
    "query": "tsx src/workshop/graph/queries.ts",
    "ingest": "tsx src/workshop/harness/ingest.ts",
    "seed:generate": "tsx scripts/generate-seed.ts",
    "seed:check": "tsx src/workshop/nsuite/seedCheck.ts",
    "neo4j:up": "docker compose up -d && echo 'waiting for neo4j...' && until docker compose exec -T neo4j cypher-shell -u neo4j -p workshop-password 'RETURN 1' >/dev/null 2>&1; do sleep 2; done && echo 'neo4j ready'",
    "neo4j:down": "docker compose down",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:llm": "tsx --test test/llm/*.test.ts"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@mastra/core": "1.76.0",
    "@mastra/editor": "^0.16.1",
    "@mastra/fastembed": "^1.3.2",
    "@mastra/libsql": "1.26.0",
    "@mastra/memory": "1.37.0",
    "dotenv": "^18.0.7",
    "neo4j-driver": "^6.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "mastra": "1.34.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
