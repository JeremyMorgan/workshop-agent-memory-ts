# Model used by the agent (Mastra "provider/model" format)
MODEL=openai/gpt-5.4-mini
# Smallest model used for extracting user-stated facts and rules (stage 3)
EXTRACTION_MODEL=openai/gpt-5.4-nano
OPENAI_API_KEY=

# Neo4j: local docker-compose defaults. For Aura use the neo4j+s:// URI from your instance.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=workshop-password
NEO4J_DATABASE=neo4j

# Optional: GraphAcademy AI proxy (set OPENAI_API_KEY to your ga- key)
# OPENAI_BASE_URL=https://graphacademy.neo4j.com/api/llm/v1
